{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "920px",
			"wideSize": "1160px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"gradients": [],
			"duotone": [],
			"palette": [
				{ "slug": "base", "color": "#faf8f4", "name": "Base" },
				{ "slug": "contrast", "color": "#14243d", "name": "Contrast" },
				{ "slug": "links", "color": "#6E1B45", "name": "Links" },
				{ "slug": "links-hover", "color": "#dd0000", "name": "Links (Hover)" },
				{ "slug": "accent", "color": "#9a7b3f", "name": "Accent" },
				{ "slug": "muted", "color": "#5B6779", "name": "Muted" },
				{ "slug": "rule", "color": "#d8d1c0", "name": "Rule" },
				{ "slug": "tint", "color": "#f3efe4", "name": "Tint" },
				{ "slug": "dark", "color": "#101c30", "name": "Dark" },
				{ "slug": "dark-muted", "color": "#cfc9ba", "name": "Dark (Muted)" },
				{ "slug": "dark-outline", "color": "#ece5d5", "name": "Dark (Outline)" }
			]
		},
		"typography": {
			"customFontSize": true,
			"fluid": false,
			"lineHeight": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Times New Roman\", Times, Georgia, \"Nimbus Roman\", serif",
					"slug": "serif",
					"name": "Serif"
				},
				{
					"fontFamily": "\"Libre Baskerville\", Georgia, \"Times New Roman\", serif",
					"slug": "libre-baskerville",
					"name": "Libre Baskerville",
					"fontFace": [
						{
							"fontFamily": "Libre Baskerville",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/libre-baskerville-400.woff2" ]
						},
						{
							"fontFamily": "Libre Baskerville",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/libre-baskerville-700.woff2" ]
						}
					]
				},
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"slug": "sans-serif",
					"name": "Sans Serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "normal", "size": "1rem", "name": "Normal" },
				{ "slug": "medium", "size": "clamp(1rem, 2vw, 1.125rem)", "name": "Medium" },
				{ "slug": "large", "size": "clamp(1.25rem, 3vw, 1.5rem)", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(1.75rem, 3vw, 2rem)", "name": "Extra Large" },
				{ "slug": "xx-large", "size": "clamp(2rem, 6vw, 2.5rem)", "name": "Double Extra Large" },
				{ "slug": "huge", "size": "clamp(2.5rem, 7vw, 3.5rem)", "name": "Huge" }
			]
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "10", "size": "10px", "name": "1" },
				{ "slug": "20", "size": "20px", "name": "2" },
				{ "slug": "30", "size": "30px", "name": "3" },
				{ "slug": "40", "size": "40px", "name": "4" },
				{ "slug": "50", "size": "50px", "name": "5" },
				{ "slug": "60", "size": "60px", "name": "6" },
				{ "slug": "70", "size": "70px", "name": "7" },
				{ "slug": "80", "size": "80px", "name": "8" }
			]
		},
		"custom": {
			"variation": "default"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--30)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--links)" },
				":visited": { "color": {  "text": "var(--wp--preset--color--links)" } },
				":hover": { "color": {  "text": "var(--wp--preset--color--links)" } },
				":focus": { "color": {  "text": "var(--wp--preset--color--links)" } },
				":focus-visible": {
					"color": { "text": "var(--wp--preset--color--links-hover)" },
					"outline": { "color": "var(--wp--preset--color--links-hover)", "style": "solid", "width": "2px", "offset": "2px" }
				},
				":active": { "color": {  "text": "var(--wp--preset--color--links)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--libre-baskerville)",
					"fontWeight": "700",
					"lineHeight": "1.25",
					"letterSpacing": "0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--normal)", "textTransform": "uppercase", "letterSpacing": "0.03em" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--links)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--normal)"
				},
				
				"border": { "radius": "0px" },
				"spacing": { "padding": { "top": "0.6em", "right": "1.4em", "bottom": "0.6em", "left": "1.4em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--links-hover)", "text": "var(--wp--preset--color--base)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--links-hover)", "text": "var(--wp--preset--color--base)" } },
				":focus-visible": {
					"color": { "background": "var(--wp--preset--color--links-hover)", "text": "var(--wp--preset--color--base)" },
					"outline": { "color": "var(--wp--preset--color--contrast)", "style": "solid", "width": "2px", "offset": "2px" }
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--libre-baskerville)",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--contrast)" }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
			},
			"core/post-title": {
				"typography": { "fontWeight": "700" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--links)" },
						":hover": { "color": {  "text": "var(--wp--preset--color--links)" } },
						":focus": { "color": {  "text": "var(--wp--preset--color--links)" } }
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": { "text": "var(--wp--preset--color--muted)" }
			},
			"core/query-pagination": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-content": {
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem" } }
			},
			"nasio-block/icon-block": {
				"css": "&.al-hathaway-icon-square .nasio-icon-wrapper svg{box-sizing:content-box;padding:10px;background-color:var(--wp--preset--color--tint)}"
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--normal)" },
				"color": { "text": "var(--wp--preset--color--links)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "header-home", "title": "Header (Home)", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "footer-home", "title": "Footer (Home)", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-full-width", "title": "Full Width", "postTypes": [ "page" ] },
		{ "name": "page-no-title", "title": "No Title", "postTypes": [ "page" ] }
	]
}
