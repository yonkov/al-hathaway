			"palette": [
				{ "slug": "base", "color": "#F3EFE4", "name": "Base" },
				{ "slug": "contrast", "color": "#3D2B1F", "name": "Contrast" },
				{ "slug": "links", "color": "#3D2B1F", "name": "Links" }
			]
