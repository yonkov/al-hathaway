{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Purple",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#4B0082", "name": "Base" },
				{ "slug": "contrast", "color": "#FFFFFF", "name": "Contrast" },
				{ "slug": "links", "color": "#FFFFFF", "name": "Links" },
				{ "slug": "links-hover", "color": "#FFFFFF", "name": "Links (Hover)" }
			]
		},
		"custom": {
			"variation": "purple"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		}
	}
}
